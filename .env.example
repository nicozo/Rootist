# rootist 環境変数のサンプル。`cp .env.example .env` して値を埋める（.env はコミットしない）
# Supabase 関連の取得手順は docs/supabase-setup.md を参照

# ━━ Supabase（開発用クラウドプロジェクトに直結） ━━
# Project Settings > API の Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings > API Keys の Publishable key（sb_publishable_...）。ブラウザに公開してよい
SUPABASE_PUBLISHABLE_KEY=
# Project Settings > API Keys の Secret key（sb_secret_...）。サーバー専用。絶対に公開・コミットしない
SUPABASE_SECRET_KEY=
# Connect > Connection string の Session pooler（IPv4 対応）。DB パスワードを含むため秘密
# Drizzle からの接続用。#115 で DATABASE_URL に統合・置き換える予定
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ━━ 外部 API ━━
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# ━━ 移行中の旧構成（MySQL + Better Auth）。#119 で削除予定 ━━
DB_NAME=
DB_USER=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://<user>:<password>@localhost:3306/<db-name>
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
RESEND_API_KEY=
# Google ログイン（任意。未設定ならボタン非表示）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ━━ git worktree（issue 単位の環境分離。詳細は CLAUDE.md「Docker 開発環境」） ━━
# メインのワーキングツリーでは不要。issue 番号 N の worktree で設定する
# COMPOSE_PROJECT_NAME=rootist-issue-<N>
# DEV_PORT=<20000+N>
# MYSQL_PORT=<30000+N>
